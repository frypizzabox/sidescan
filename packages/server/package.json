{
  "name": "sidescan",
  "version": "0.1.0",
  "description": "Standalone self-hostable competitive intel server for solo devs",
  "license": "MIT",
  "type": "module",
  "bin": { "sidescan": "./bin/sidescan" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist/", "bin/", "src/config/example.yaml"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsup",
    "dev": "tsx --watch src/cli/index.ts start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "better-sqlite3": "^11.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "hono": "^4.6.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "yaml": "^2.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.17.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
