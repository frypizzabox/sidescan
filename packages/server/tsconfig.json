{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "allowImportingTsExtensions": false,
    "noEmit": true
  },
  "include": ["src/**/*", "test/**/*", "*.config.ts"],
  "exclude": ["dist", "node_modules"]
}
