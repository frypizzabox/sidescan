{
  "name": "sidescan-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Sidescan — self-hostable competitive intel server for solo devs",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev:server": "npm run dev --workspace=packages/server",
    "dev:web":    "npm run dev --workspace=packages/web",
    "build":      "npm run build --workspace=packages/web && npm run build --workspace=packages/server",
    "test":       "npm run test --workspaces --if-present",
    "typecheck":  "npm run typecheck --workspaces --if-present",
    "format":     "prettier --write .",
    "format:check": "prettier --check .",
    "lint":       "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
